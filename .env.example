# Copier ce fichier en .env et remplir les valeurs (Supabase → Project Settings → API)
# Ne jamais committer le fichier .env

# URL publique du projet Supabase
PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé service_role : secrète, utilisée uniquement côté serveur (src/lib/server)
SUPABASE_SERVICE_ROLE_KEY=a-remplir-en-local
